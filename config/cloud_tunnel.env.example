# SSH tunnel to the cloud GPU for the policy server.
#
# Copy to config/cloud_tunnel.env (git-ignored) and fill in your instance's
# SSH details — your GPU provider shows them on the instance page
# (e.g. "ssh -p <port> root@<host>"):
#
#   cp config/cloud_tunnel.env.example config/cloud_tunnel.env

# SSH login of your rented GPU instance (replace with YOUR values)
AUTODL_USER=root
AUTODL_HOST=<your-ssh-host>
AUTODL_PORT=<your-ssh-port>

# Local port the deploy script connects to (--policy-port), and the port
# serve_policy.py listens on inside the instance. Keep both 8000 unless they
# clash with something local.
LOCAL_PORT=8000
REMOTE_PORT=8000

# Optional: explicit SSH identity file (defaults to ~/.ssh/id_ed25519 etc.)
# SSH_KEY=~/.ssh/id_ed25519
